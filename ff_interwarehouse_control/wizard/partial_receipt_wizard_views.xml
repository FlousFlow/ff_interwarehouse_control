<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="ff_partial_reason_wizard_form" model="ir.ui.view">
            <field name="name">ff.interwarehouse.partial.reason.wizard.form</field>
            <field name="model">ff.interwarehouse.partial.reason.wizard</field>
            <field name="arch" type="xml">
                <form string="Record Partial Receipt Reason">
                    <group>
                        <group>
                            <field name="transfer_id"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list string="Partially received products" editable="bottom">
                            <field name="product_id" readonly="1"/>
                            <field name="dispatched_qty" readonly="1"/>
                            <field name="received_qty" readonly="1"/>
                            <field name="in_transit_qty" readonly="1"/>
                            <field name="reason"/>
                            <field name="note"/>
                        </list>
                    </field>
                    <footer>
                        <button name="action_save" type="object" string="Save" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
