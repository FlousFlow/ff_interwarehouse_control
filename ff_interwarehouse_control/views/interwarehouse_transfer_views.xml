<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="ff_interwarehouse_transfer_tree" model="ir.ui.view">
            <field name="name">ff.interwarehouse.transfer.tree</field>
            <field name="model">ff.interwarehouse.transfer</field>
            <field name="arch" type="xml">
                <list string="Inter-Warehouse Transfers" decoration-danger="ff_is_overdue" decoration-muted="state == 'done' or state == 'cancelled'">
                    <field name="name"/>
                    <field name="source_name"/>
                    <field name="destination_name"/>
                    <field name="request_date"/>
                    <field name="state" widget="badge" decoration-success="state == 'done'"/>
                    <field name="dispatched_qty_total" string="Dispatched"/>
                    <field name="received_qty_total" string="Received"/>
                    <field name="in_transit_qty_total" string="In Transit"/>
                    <field name="responsible_user_id"/>
                </list>
            </field>
        </record>

        <record id="ff_interwarehouse_transfer_search" model="ir.ui.view">
            <field name="name">ff.interwarehouse.transfer.search</field>
            <field name="model">ff.interwarehouse.transfer</field>
            <field name="arch" type="xml">
                <search string="Inter-Warehouse Transfers">
                    <field name="name"/>
                    <field name="source_warehouse_id"/>
                    <field name="destination_warehouse_id"/>
                    <field name="responsible_user_id"/>
                    <field name="state"/>
                    <filter name="to_dispatch" string="To Dispatch" domain="[('state', '=', 'confirmed')]"/>
                    <filter name="incoming" string="Incoming" domain="[('state', 'in', ('in_transit', 'partially_received'))]"/>
                    <filter name="in_transit" string="In Transit" domain="[('state', '=', 'in_transit')]"/>
                    <filter name="partially_received" string="Partially Received" domain="[('state', '=', 'partially_received')]"/>
                    <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                    <filter name="overdue" string="Overdue" domain="[('ff_is_overdue', '=', True)]"/>
                    <separator/>
                    <filter name="my_transfers" string="My Transfers" domain="[('initiator_user_id', '=', uid)]"/>
                    <filter name="responsible_me" string="My Responsibility" domain="[('responsible_user_id', '=', uid)]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                        <filter name="group_source" string="Source" context="{'group_by': 'source_warehouse_id'}"/>
                        <filter name="group_destination" string="Destination" context="{'group_by': 'destination_warehouse_id'}"/>
                        <filter name="group_responsible" string="Responsible" context="{'group_by': 'responsible_user_id'}"/>
                        <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="ff_interwarehouse_transfer_form" model="ir.ui.view">
            <field name="name">ff.interwarehouse.transfer.form</field>
            <field name="model">ff.interwarehouse.transfer</field>
            <field name="arch" type="xml">
                <form string="Inter-Warehouse Transfer">
                    <header>
                        <button name="action_confirm" type="object" string="Confirm"
                                class="btn-primary" invisible="state != 'draft'"/>
                        <button name="action_open_dispatch" type="object" string="Open Dispatch"
                                invisible="state not in ('confirmed', 'partially_dispatched', 'in_transit', 'partially_received')"/>
                        <button name="action_open_receipt" type="object" string="Receive"
                                class="btn-primary"
                                invisible="state not in ('in_transit', 'partially_received', 'partially_dispatched')"/>
                        <button name="action_record_partial_reason" type="object" string="Record Reason"
                                invisible="state != 'partially_received'"/>
                        <button name="action_return_to_source" type="object" string="Return to Source"
                                invisible="state not in ('in_transit', 'partially_received', 'partially_dispatched')"/>
                        <button name="action_resolve_difference" type="object" string="Resolve Difference"
                                groups="ff_interwarehouse_control.group_interwarehouse_manager"
                                invisible="state not in ('in_transit', 'partially_received', 'partially_dispatched')"/>
                        <button name="action_cancel" type="object" string="Cancel"
                                invisible="state not in ('draft', 'confirmed')"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,in_transit,partially_received,done"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>

                        <group>
                            <group>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="source_name" string="Source Warehouse"/>
                                <field name="destination_name" string="Destination Warehouse"/>
                                <field name="lane_id" readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name="initiator_user_id"/>
                                <field name="responsible_user_id"/>
                                <field name="request_date"/>
                                <field name="dispatch_date"/>
                                <field name="completion_date"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Products">
                                <field name="line_ids">
                                    <list string="Products" editable="bottom">
                                        <field name="product_id" readonly="parent.state != 'draft' and parent.state != 'confirmed'"/>
                                        <field name="product_uom_id" readonly="parent.state != 'draft' and parent.state != 'confirmed'"/>
                                        <field name="requested_qty" readonly="parent.state != 'draft' and parent.state != 'confirmed'"/>
                                        <field name="dispatched_qty" readonly="1"/>
                                        <field name="received_qty" readonly="1"/>
                                        <field name="in_transit_qty" readonly="1"/>
                                    </list>
                                    <form string="Products">
                                        <group>
                                            <group>
                                                <field name="product_id" readonly="parent.state != 'draft' and parent.state != 'confirmed'"/>
                                                <field name="product_uom_id" readonly="parent.state != 'draft' and parent.state != 'confirmed'"/>
                                                <field name="requested_qty" readonly="parent.state != 'draft' and parent.state != 'confirmed'"/>
                                            </group>
                                            <group>
                                                <field name="dispatched_qty" readonly="1"/>
                                                <field name="received_qty" readonly="1"/>
                                                <field name="pending_dispatch_qty" readonly="1"/>
                                                <field name="in_transit_qty" readonly="1"/>
                                                <field name="returned_qty" readonly="1"/>
                                                <field name="scrapped_qty" readonly="1"/>
                                            </group>
                                        </group>
                                        <group string="Partial Receipt">
                                            <field name="partial_receipt_reason"/>
                                            <field name="partial_receipt_note"/>
                                        </group>
                                    </form>
                                </field>
                            </page>
                            <page string="Notes">
                                <field name="notes" placeholder="Add internal notes..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="ff_action_interwarehouse_transfer" model="ir.actions.act_window">
            <field name="name">Inter-Warehouse Transfers</field>
            <field name="res_model">ff.interwarehouse.transfer</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="ff_interwarehouse_transfer_search"/>
            <field name="context">{'search_default_my_transfers': 1}</field>
        </record>

    </data>
</odoo>
